# PostgreSQL – Datalake (histórico final)
STAGING_POSTGRES_HOST=localhost
STAGING_POSTGRES_PORT=5432
STAGING_POSTGRES_DB=your_staging_db
STAGING_POSTGRES_USER=your_postgres_user
STAGING_POSTGRES_PASSWORD=your_secure_password

# PostgreSQL – Work DB (borradores / trabajos intermedios)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_work_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_password

# Azurite / Azure Storage
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
STORAGE_AUTO_CREATE_CONTAINERS=true   # local, dev (false en prod)

# Logging Configuration
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false
APP_LOG_DIR=logs
APP_LOG_ROOT_FILE=root.log

APP_LOG_NAMESPACE=your_project_name
APP_LOG_NAMESPACE_FILE=your_project_name.log

# LLM – principal y respaldo (formato proveedor:modelo de LangChain)
GOOGLE_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=google_genai:gemini-2.5-flash
LLM_FALLBACK_MODEL=groq:llama-3.3-70b-versatile

# Búsqueda de información pública
TAVILY_API_KEY=your_tavily_api_key
