# Variables de entorno para tests/CI (sin secretos reales)
STAGING_POSTGRES_HOST=localhost
STAGING_POSTGRES_PORT=5432
STAGING_POSTGRES_DB=xchg
STAGING_POSTGRES_USER=postgres
STAGING_POSTGRES_PASSWORD=1234

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234

# Azurite / Azure Storage
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
STORAGE_AUTO_CREATE_CONTAINERS=true

# Logging
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false
APP_LOG_DIR=logs
APP_LOG_ROOT_FILE=root.log
APP_LOG_NAMESPACE=gestion_contenidos
APP_LOG_NAMESPACE_FILE=gestion_contenidos.log
