APP_NAME=gestion-contenidos-api
APP_ENV=local
APP_VERSION=0.1.0

AUDIT_ENABLED=false

# Logging Configuration
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false
APP_LOG_DIR=logs
APP_LOG_ROOT_FILE=root.log

APP_LOG_NAMESPACE=gestion_contenidos_api
APP_LOG_NAMESPACE_FILE=gestion_contenidos_api.log
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# OpenAI Chat Model
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.6

# Search
SEARCH_DEFAULT_LIMIT=5
SEARCH_MAX_LIMIT=20
